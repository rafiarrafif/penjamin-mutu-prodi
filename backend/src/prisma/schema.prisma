generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlserver"
}

model DataCategory {
  id           String            @id @db.UniqueIdentifier
  slug         String            @db.VarChar(255)
  name         String            @db.VarChar(255)
  requirements DataRequirement[]

  @@index([slug], map: "index_2")
  @@map("data_categories")
}

model DataRequirement {
  dataCategoryId String          @map("data_category_id") @db.UniqueIdentifier
  id             String          @id @db.UniqueIdentifier
  frequencyCode  String          @map("frequency_code") @db.VarChar(32)
  name           String          @db.VarChar(500)
  category       DataCategory    @relation(fields: [dataCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  frequency      Frequency       @relation(fields: [frequencyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  entries        DataEntry[]
  departmentPics DepartmentPic[]

  @@map("data_requirements")
}

model DataEntry {
  dataRequirementId String           @map("data_requirement_id") @db.UniqueIdentifier
  id                String           @id @db.UniqueIdentifier
  periodId          String           @map("period_id") @db.UniqueIdentifier
  filename          String           @db.VarChar(255)
  filetype          String           @db.VarChar(12)
  fileSize          Int              @map("file_size")
  isSecret          Boolean          @map("is_secret") @db.Bit
  requirement       DataRequirement  @relation(fields: [dataRequirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period            Period           @relation(fields: [periodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileUpload        FileUpload?
  submission        Submission?
  scoringResults    ScoringResult[]

  @@map("data_entries")
}

model FileUpload {
  dataEntryId String    @id @map("data_entry_id") @db.UniqueIdentifier
  blob        String    @db.VarChar(500)
  dataEntry   DataEntry @relation(fields: [dataEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("file_uploads")
}

model Department {
  id              String              @id @db.UniqueIdentifier
  name            String              @db.VarChar(115)
  description     String?             @db.VarChar(255)
  accountIdCreator String              @map("account_id_creator") @db.UniqueIdentifier
  accountIdUpdater String?             @map("account_id_updater") @db.UniqueIdentifier
  createdAt       DateTime            @map("created_at") @db.DateTime2
  updatedAt       DateTime            @map("updated_at") @db.DateTime2
  deletedAt       DateTime?           @map("deleted_at") @db.DateTime2
  creator         Account             @relation("DepartmentCreator", fields: [accountIdCreator], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater         Account?            @relation("DepartmentUpdater", fields: [accountIdUpdater], references: [id], onDelete: NoAction, onUpdate: NoAction)
  histories       DepartmentHistory[]
  pics            DepartmentPic[]

  @@map("departments")
}

model Account {
  id                       String                @id @db.UniqueIdentifier
  sub                      String                @db.VarChar(255)
  fullname                 String                @db.VarChar(255)
  email                    String                @unique @db.VarChar(255)
  profilePicture           String?               @map("profile_picture") @db.VarChar(255)
  role                     String                @db.VarChar(12)
  sex                      String                @db.VarChar(6)
  phoneNo                  String?               @map("phone_no") @db.VarChar(15)
  address                  String?               @db.VarChar(255)
  isVerified               Boolean               @map("is_verfied") @db.Bit
  updatedAt                DateTime              @map("updated_at") @db.DateTime2
  createdAt                DateTime              @map("created_at") @db.DateTime2
  deletedAt                DateTime?             @map("deleted_at") @db.DateTime2
  sessions                 Session[]
  notifications            AccountNotification[]
  departmentHistories      DepartmentHistory[]   @relation("DepartmentHistoryAccount")
  departmentAssignments    DepartmentHistory[]   @relation("DepartmentHistoryAssigner")
  submittedSubmissions     Submission[]          @relation("SubmissionSubmitter")
  reviewedSubmissions      Submission[]          @relation("SubmissionReviewer")
  scoringMethodsCreated    ScoringMethod[]       @relation("ScoringMethodCreator")
  scoringMethodsUpdated    ScoringMethod[]       @relation("ScoringMethodUpdater")
  scoringFormulasCreated   ScoringFormula[]      @relation("ScoringFormulaCreator")
  scoringFormulasUpdated   ScoringFormula[]      @relation("ScoringFormulaUpdater")
  departmentPicAssignments DepartmentPic[]       @relation("DepartmentPicAssigner")
  departmentsCreated      Department[]          @relation("DepartmentCreator")
  departmentsUpdated      Department[]          @relation("DepartmentUpdater")

  @@map("accounts")
}

model Session {
  id           String      @id @db.UniqueIdentifier
  accountId    String      @map("account_id") @db.UniqueIdentifier
  deviceType   String      @map("device_type") @db.VarChar(8)
  deviceOs     String?     @map("device_os") @db.VarChar(255)
  browser      String?     @db.VarChar(255)
  ipAddress    String?     @map("ip_address") @db.VarChar(45)
  accessToken  String?     @map("access_token") @db.VarChar(375)
  refreshToken String?     @map("refresh_token") @db.VarChar(375)
  loggedInAt   DateTime    @map("logged_in_at") @db.DateTime2
  revokedAt    DateTime?   @map("revoked_at") @db.DateTime2
  account      Account     @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changeLogs   ChangeLog[]

  @@map("sessions")
}

model AccountNotification {
  id          String  @id @db.UniqueIdentifier
  accountId   String  @map("account_id") @db.UniqueIdentifier
  title       String  @db.VarChar(500)
  description String  @db.VarChar(500)
  account     Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("account_notification")
}

model DepartmentHistory {
  id                String     @id @db.UniqueIdentifier
  accountId         String     @map("account_id") @db.UniqueIdentifier
  departmentId      String     @map("department_id") @db.UniqueIdentifier
  startDate         DateTime   @map("start_date") @db.Date
  endDate           DateTime?  @map("end_date") @db.Date
  accountIdAssigner String     @map("account_id_assigner") @db.UniqueIdentifier
  createdAt         DateTime   @map("created_at") @db.DateTime2
  account           Account    @relation("DepartmentHistoryAccount", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigner          Account    @relation("DepartmentHistoryAssigner", fields: [accountIdAssigner], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department        Department @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("department_histories")
}

model DepartmentPic {
  departmentId      String          @map("department_id") @db.UniqueIdentifier
  requirementId     String          @map("requirement_id") @db.UniqueIdentifier
  accountIdAssigner String          @map("account_id_assigner") @db.UniqueIdentifier
  createdAt         DateTime        @map("created_at") @db.DateTime2
  department        Department      @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requirement       DataRequirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigner          Account         @relation("DepartmentPicAssigner", fields: [accountIdAssigner], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([departmentId, requirementId])
  @@map("department_pics")
}

model Submission {
  entryId            String    @id @map("entry_id") @db.UniqueIdentifier
  accountIdSubmitter String    @map("account_id_submiter") @db.UniqueIdentifier
  accountIdReviewer  String?   @map("account_id_reviewer") @db.UniqueIdentifier
  status             String    @default("hold") @db.VarChar(8)
  reviewerMessage    String?   @map("reviewer_message") @db.VarChar(255)
  reviewedAt         DateTime? @map("reviewed_at") @db.DateTime2
  createdAt          DateTime  @map("created_at") @db.DateTime2
  updatedAt          DateTime  @map("updated_at") @db.DateTime2
  deletedAt          DateTime? @map("deleted_at") @db.DateTime2
  dataEntry          DataEntry @relation(fields: [entryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submitter          Account   @relation("SubmissionSubmitter", fields: [accountIdSubmitter], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer           Account?  @relation("SubmissionReviewer", fields: [accountIdReviewer], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("submissions")
}

model ScoringMethod {
  id               String          @id @db.UniqueIdentifier
  name             String          @db.VarChar(255)
  successRate      Decimal         @map("success_rate") @db.Decimal(5, 2)
  passRate         Decimal         @map("pass_rate") @db.Decimal(5, 2)
  accountIdCreator String          @map("account_id_creator") @db.UniqueIdentifier
  accountIdUpdater String          @map("account_id_updater") @db.UniqueIdentifier
  createdAt        DateTime        @map("created_at") @db.DateTime2
  updatedAt        DateTime        @map("update_at") @db.DateTime2
  deletedAt        DateTime?       @map("deleted_at") @db.DateTime2
  creator          Account         @relation("ScoringMethodCreator", fields: [accountIdCreator], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater          Account         @relation("ScoringMethodUpdater", fields: [accountIdUpdater], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulas         ScoringFormula[]
  results          ScoringResult[]

  @@map("scoring_methods")
}

model ScoringFormula {
  id              String        @id @db.UniqueIdentifier
  scoringMethodId String        @map("scoring_method_id") @db.UniqueIdentifier
  attribute       String        @unique @db.VarChar(255)
  attributeType   String        @map("attribute_type") @db.VarChar(10)
  description     String?       @db.VarChar(400)
  accountIdCreator String       @map("account_id_creator") @db.UniqueIdentifier
  accountIdUpdater String       @map("account_id_updater") @db.UniqueIdentifier
  createdAt       DateTime      @map("created_at") @db.DateTime2
  updatedAt       DateTime      @map("update_at") @db.DateTime2
  deletedAt       DateTime?     @map("deleted_at") @db.DateTime2
  scoringMethod   ScoringMethod @relation(fields: [scoringMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator         Account       @relation("ScoringFormulaCreator", fields: [accountIdCreator], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater         Account       @relation("ScoringFormulaUpdater", fields: [accountIdUpdater], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("scoring_formula")
}

model ScoringResult {
  dataEntryId     String        @map("data_entry_id") @db.UniqueIdentifier
  scoringMethodId String        @map("scoring_method_id") @db.UniqueIdentifier
  proofLink       String        @map("proof_link") @db.VarChar(255)
  period          String        @db.VarChar(255)
  dataEntry       DataEntry     @relation(fields: [dataEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scoringMethod   ScoringMethod @relation(fields: [scoringMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([dataEntryId, scoringMethodId])
  @@map("scoring_result")
}

model Frequency {
  code         String            @id @db.VarChar(32)
  label        String            @db.VarChar(225)
  requirements DataRequirement[]
  periods      Period[]

  @@map("frequencies")
}

model Period {
  id            String      @id @db.UniqueIdentifier
  frequencyCode String      @map("frequency_code") @db.VarChar(32)
  label         String      @db.VarChar(64)
  year          Int         @db.SmallInt
  month         Int?        @db.SmallInt
  semester      Int?        @db.SmallInt
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  frequency     Frequency   @relation(fields: [frequencyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  entries       DataEntry[]

  @@map("periods")
}

model ChangeLog {
  id               String   @id @db.UniqueIdentifier
  sessionIdRelated String   @map("session_id_related") @db.UniqueIdentifier
  relatedModule    String   @map("related_module") @db.VarChar(155)
  moduleName       String   @map("module_name") @db.VarChar(155)
  action           String   @db.VarChar(8)
  description      String   @db.VarChar(500)
  createdAt        DateTime @map("created_at") @db.DateTime2
  session          Session  @relation(fields: [sessionIdRelated], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("change_logs")
}

model FailedLoginLog {
  id          String    @id @db.UniqueIdentifier
  email       String    @db.VarChar(255)
  name        String?   @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  deviceInfo  String?   @map("device_info") @db.VarChar(255)
  browserInfo String?   @map("browser_info") @db.VarChar(255)
  attemptAt   DateTime  @map("attempt_at") @db.DateTime2

  @@map("failed_login_logs")
}